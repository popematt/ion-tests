// Escapes that decode to a quote or a backslash must not close the literal or
// start another escape.
// Groups are lists because adjacent long strings in an s-expression are
// concatenated.

[
  "\"",
  "\x22",
  "\u0022",
  "\U00000022",
  '''"''',
  '''\"''',
  '''\x22''',
  '''\u0022''',
]

[
  "'",
  "\'",
  "\x27",
  "\u0027",
  "\U00000027",
  '''\'''',
  '''\x27''',
  '''\u0027''',
]

[
  "\\",
  "\x5c",
  "\x5C",
  "\u005c",
  "\U0000005C",
  '''\\''',
  '''\x5c''',
  '''\u005c''',
]

[
  "'''",
  "\x27\x27\x27",
  '''\'\'\'''',
  '''\x27\x27\x27''',
  '''\u0027\u0027\u0027''',
]

[
  "\\n",
  "\x5cn",
  "\u005cn",
  '''\x5cn''',
]

[
  "\\u0041",
  "\x5cu0041",
  "\u005cu0041",
  '''\x5cu0041''',
]

[
  '\'',
  '\x27',
  '\u0027',
  '\U00000027',
]

[
  '"',
  '\"',
  '\x22',
  '\u0022',
  '\U00000022',
]

[
  '\\',
  '\x5c',
  '\u005C',
  '\U0000005c',
]

[
  '\\n',
  '\x5cn',
  '\u005cn',
]

[
  {'\'':null},
  {'\x27':null},
  {'\u0027':null},
  {"'":null},
  {"\x27":null},
  {'''\x27''':null},
]

[
  {'"':null},
  {'\x22':null},
  {"\"":null},
  {"\x22":null},
  {"\u0022":null},
]

[
  {'\\':null},
  {'\x5c':null},
  {"\\":null},
  {"\u005c":null},
  {'''\x5c''':null},
]

[
  '\''::null,
  '\x27'::null,
  '\u0027'::null,
]

[
  '"'::null,
  '\"'::null,
  '\x22'::null,
  '\u0022'::null,

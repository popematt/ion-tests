// Double dagger is a 3-byte UTF-8 character

(
  "\u2021"
  "\U00002021"
  "‡"
)

(
  '\u2021'
  '\U00002021'
  '‡'
)

(
  {'\u2021':null}
  {'\U00002021':null}
  {'‡':null}
  {"\u2021":null}
  {"\U00002021":null}
  {"‡":null}
  {'''\u2021''':null}
)

(
  '\u2021'::null
  '\U00002021'::null
  '‡'::null
)
